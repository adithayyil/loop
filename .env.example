# Anthropic API key — powers the event->step-list compiler (and replay fallback agent)
CLAUDE_KEY=

# Steel API key — cloud browser sessions, profiles, files. Server-side only, never
# shipped to the client or printed in logs.
STEEL_KEY=

# Optional Steel stealth/captcha behavior (off by default; solving adds latency + cost).
# LOOP_SOLVE_CAPTCHA=1  auto-solve detected captchas (Steel requires a paid balance;
#                       if unavailable we log a warning and retry without it)
# LOOP_HUMANIZE=1       human-like mouse movement (helps with bot detection)

# Optional Steel proxy routing (off by default; managed proxies bill against the balance).
# LOOP_USE_PROXY=1      route sessions through a Steel managed proxy
# LOOP_PROXY_COUNTRY=US  pin the managed proxy's geolocation
# LOOP_PROXY_URL=       custom proxy URL; overrides LOOP_USE_PROXY

# Optional voice narration during recording. Any OpenAI-compatible speech API works.
# Auto-detected, in order: OPENROUTER_API_KEY, GROQ_API_KEY, OPENAI_KEY. Without a key,
# recording and compiling still work, just without narration.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Swap providers by setting the base URL + key together (any OpenAI-compatible host):
#   OpenAI:     LOOP_WHISPER_BASE_URL=https://api.openai.com/v1        LOOP_WHISPER_KEY=<key>
#   DeepInfra:  LOOP_WHISPER_BASE_URL=https://api.deepinfra.com/v1    LOOP_WHISPER_KEY=<key>
#               LOOP_WHISPER_MODEL=openai/whisper-large-v3-turbo
#   OpenRouter: LOOP_WHISPER_BASE_URL=https://openrouter.ai/api/v1    LOOP_WHISPER_KEY=<key>
#               LOOP_WHISPER_MODEL=openai/whisper-large-v3
#   Local:      LOOP_WHISPER_BASE_URL=http://localhost:8000/v1         LOOP_WHISPER_KEY=local
# LOOP_WHISPER_MODEL=whisper-large-v3-turbo

# Optional vision-model override for the canvas/visual self-heal fallback.
# LOOP_VISION_MODEL=claude-sonnet-4-5
