# Anthropic API key — powers the event->step-list compiler (and replay fallback agent)
CLAUDE_KEY=

# Steel API key — cloud browser sessions, profiles, files. Server-side only, never
# shipped to the client or printed in logs.
STEEL_KEY=

# Optional Steel stealth/captcha behavior (off by default; solving adds latency + cost).
# LOOP_SOLVE_CAPTCHA=1  auto-solve detected captchas (Steel requires a paid balance;
#                       if unavailable we log a warning and retry without it)
# LOOP_HUMANIZE=1       human-like mouse movement (helps with bot detection)
